# Multica 自架（TW199501 繁中版）— Dockhand 環境變數
# 未列出的變數都採 compose.yaml 的預設值；完整清單見 repo 根目錄的 .env.example。

# ---- 建置版號（建議填 release 上對應的 tag） ----
MULTICA_BUILD_VERSION=v0.7.0-tw.1

# ---- 必填 ----
# openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# ---- 對外網址（反向代理後的網域） ----
FRONTEND_ORIGIN=https://multica.example.com
MULTICA_PUBLIC_URL=https://multica.example.com

# ---- 主機埠（只綁 127.0.0.1，由反向代理轉入） ----
FRONTEND_PORT=3000
PORT=8080

# ---- 登入驗證信（擇一；都不設時驗證碼只印在 backend 容器 log） ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# ---- 註冊與工作區 ----
ALLOW_SIGNUP=false
# 逗號分隔；只有這些 email 能建立工作區
WORKSPACE_CREATION_ALLOWED_EMAILS=

# ---- 說明文件：自架不含文件站，指向官方 ----
DOCS_URL=https://multica.ai
