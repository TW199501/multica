# Multica 自架（TW199501 繁中版）— Dockhand 環境變數
# 未列出的變數都採 docker-compose.dockhand.yml 的預設值；完整清單見 repo 根目錄的 .env.example。

# ---- 建置來源與版號 ----
# Git stack 不用設：建置 Dockhand 拉下來的分支。
# 只貼 compose、沒有 repo 時才設，例如：
# MULTICA_BUILD_CONTEXT=https://github.com/TW199501/multica.git#release
MULTICA_BUILD_VERSION=v0.7.0-tw.3

# ---- 必填 ----
# openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# ---- 對外網址（反向代理後的網域） ----
FRONTEND_ORIGIN=https://multica.example.com
MULTICA_PUBLIC_URL=https://multica.example.com
# 前端網址：Slack／Telegram 等整合回覆裡的連結、CLI 安裝設定都用它。
# compose 預設是 http://localhost:3000，不會改用 FRONTEND_ORIGIN，所以要設。
MULTICA_APP_URL=https://multica.example.com

# ---- 主機埠 ----
# 預設只綁 127.0.0.1，由反向代理轉入；內網測試機可改成主機的 IP（例如 192.168.25.100）。
# 對外公開的機器不要改成 0.0.0.0。
# MULTICA_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
PORT=8080

# ---- 登入驗證信（擇一；都不設時驗證碼只印在 backend 容器 log） ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# 只限內網測試：不寄信、改用固定驗證碼。兩個要一起設（APP_ENV=production 時固定碼無效）；對外開放前刪掉。
# APP_ENV=development
# MULTICA_DEV_VERIFICATION_CODE=888888

# ---- 註冊與工作區 ----
ALLOW_SIGNUP=false
# 逗號分隔；只有這些 email 能建立工作區
WORKSPACE_CREATION_ALLOWED_EMAILS=

# ---- 回傳統計 ----
# 上游預設每天把匿名統計（工作區數、成員數、任務數等區間值）送到 telemetry.multica.ai。
# 本 compose 預設 DO_NOT_TRACK=1 關閉；要開回去就設成空字串。
# DO_NOT_TRACK=

# ---- 說明文件：自架不含文件站，指向官方 ----
DOCS_URL=https://multica.ai

# ---- 下載頁與更新來源 ----
# 下載頁、CLI 更新檢查要讀哪個 repo 的 GitHub Releases（"owner/name"）；不設 = 上游 multica-ai/multica。
# 下載頁優先列安裝檔齊全的最新正式版（規則見 README「下載頁與桌面版」）。
MULTICA_RELEASE_REPOSITORY=TW199501/multica
