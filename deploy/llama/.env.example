# Copy to .env next to docker-compose.yml and fill in.

# Folder on this host that already holds your GGUF files. Point it at the
# folder another tool already uses (LM Studio, a shared model folder) so the
# same model is not downloaded twice.
LLAMA_MODELS_DIR=

# GGUF file name inside LLAMA_MODELS_DIR, for example qwen3-4b-q4_k_m.gguf.
LLAMA_MODEL=

# Host port for the OpenAI-compatible API (default 8080).
LLAMA_PORT=8080
